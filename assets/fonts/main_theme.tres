[gd_resource type="Theme" load_steps=10 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Sarabun-Regular.ttf" id="1_regular"]
[ext_resource type="FontFile" path="res://assets/fonts/Sarabun-Bold.ttf" id="2_bold"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoColorEmoji.ttf" id="3_emoji"]
[ext_resource type="FontFile" path="res://assets/fonts/Gelasio-Bold.ttf" id="4_serif"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSerifThai-Bold.ttf" id="5_serif_thai"]

[sub_resource type="FontVariation" id="FontVariation_regular"]
base_font = ExtResource("1_regular")
fallbacks = Array[Font]([ExtResource("3_emoji")])

[sub_resource type="FontVariation" id="FontVariation_bold"]
base_font = ExtResource("2_bold")
fallbacks = Array[Font]([ExtResource("3_emoji")])

[sub_resource type="FontVariation" id="FontVariation_bigemoji"]
base_font = ExtResource("3_emoji")
spacing_top = -34
spacing_bottom = -33

[sub_resource type="FontVariation" id="FontVariation_serif"]
base_font = ExtResource("4_serif")
fallbacks = Array[Font]([ExtResource("5_serif_thai"), ExtResource("3_emoji")])

[resource]
default_font = SubResource("FontVariation_regular")
EmojiPic/base_type = &"Label"
EmojiPic/font_sizes/font_size = 155
EmojiPic/fonts/font = SubResource("FontVariation_bigemoji")
BoldLabel/base_type = &"Label"
BoldLabel/fonts/font = SubResource("FontVariation_bold")
SerifLabel/base_type = &"Label"
SerifLabel/fonts/font = SubResource("FontVariation_serif")
Button/fonts/font = SubResource("FontVariation_bold")
PlainButton/base_type = &"Button"
PlainButton/fonts/font = SubResource("FontVariation_regular")
RichTextLabel/fonts/bold_font = SubResource("FontVariation_bold")
