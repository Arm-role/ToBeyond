[gd_resource type="Theme" load_steps=6 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Sarabun-Regular.ttf" id="1_regular"]
[ext_resource type="FontFile" path="res://assets/fonts/Sarabun-Bold.ttf" id="2_bold"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoColorEmoji.ttf" id="3_emoji"]

[sub_resource type="FontVariation" id="FontVariation_regular"]
base_font = ExtResource("1_regular")
fallbacks = Array[Font]([ExtResource("3_emoji")])

[sub_resource type="FontVariation" id="FontVariation_bold"]
base_font = ExtResource("2_bold")
fallbacks = Array[Font]([ExtResource("3_emoji")])

[resource]
default_font = SubResource("FontVariation_regular")
RichTextLabel/fonts/bold_font = SubResource("FontVariation_bold")
